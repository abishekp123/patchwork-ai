# Copy to .env at the project root. The backend command in README loads this file.
# Relative paths resolve from the backend working directory.
PATCHWORK_DATABASE_PATH=data/patchwork.db

# Vite reads the root .env; this value stays on the development server.
PATCHWORK_API_PROXY_TARGET=http://127.0.0.1:8000

# Repository storage defaults to ~/.local/share/patchwork-ai/repositories.
# An override must be outside this source tree; existing directories need mode 0700.
# PATCHWORK_REPOSITORY_DIR=/absolute/private/path/to/repositories
PATCHWORK_CLONE_TIMEOUT_SECONDS=60
PATCHWORK_INGESTION_TIMEOUT_SECONDS=120
PATCHWORK_MAX_REPOSITORY_BYTES=50000000
PATCHWORK_MAX_FILE_BYTES=512000
PATCHWORK_MAX_SOURCE_BYTES=10000000
PATCHWORK_MAX_TREE_ENTRIES=20000
PATCHWORK_MAX_PYTHON_FILES=2000
PATCHWORK_MAX_SYMBOLS=50000
PATCHWORK_MAX_RESULTS=100
PATCHWORK_MAX_SNIPPET_CHARS=300
